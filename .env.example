# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini API (학습 성향 분석)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API (등록 안내문 생성)
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-4-5-20251001

# 사이트 기본 URL (카카오톡 공유 등에 사용, 프로덕션 도메인 입력)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# NK Academy 설정 (선택)
NK_ACADEMY_VEHICLE_FEE=20000
NK_ACADEMY_BANK_INFO=
NK_ACADEMY_BANK_OWNER=

# Solapi/CoolSMS Alimtalk (server only; do not expose with NEXT_PUBLIC_)
# Solapi/CoolSMS API key for server-side calls.
SOLAPI_API_KEY=
# Solapi/CoolSMS API secret for server-side calls.
SOLAPI_API_SECRET=
# Alimtalk sender profile ID.
SOLAPI_PFID=
# Sender phone number for SMS/LMS fallback.
SOLAPI_SENDER_PHONE=
